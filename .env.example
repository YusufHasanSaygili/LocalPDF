# LocalPDF local-only configuration. Copy to .env for persistent custom values.
# Never commit .env or real credentials.

COMPOSE_PROJECT_NAME=localpdf

# Host binding: keep localhost unless you explicitly perform a new security review.
WEB_HOST=127.0.0.1
WEB_PORT=3000
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_URL=http://api:8000

# User-owned local storage. Relative paths are resolved from the repository root.
LOCAL_DATA_DIR=./data
LOCAL_BACKUP_DIR=./backups

# PostgreSQL is local to the Compose network. Replace password in your private .env.
POSTGRES_DB=localpdf
POSTGRES_USER=localpdf
POSTGRES_PASSWORD=change-me-in-dot-env
DATABASE_URL=postgresql+psycopg://localpdf:change-me-in-dot-env@db:5432/localpdf

# Application-only secret: generate a long random value in .env before non-demo use.
APP_SECRET_KEY=change-me-to-a-long-random-local-secret
INVITE_TOKEN_PEPPER=change-me-to-another-long-random-local-secret

# Limits
MAX_UPLOAD_BYTES=524288000
MAX_PDF_PAGES=2000
MAX_CONCURRENT_JOBS=2
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
TOOL_TIMEOUT_SECONDS=600
PREVIEW_DPI=110

# Lifecycle: blank default expiry means no automatic expiry.
DEFAULT_EXPIRY_DAYS=
EXPIRED_PURGE_GRACE_DAYS=7
TEMP_FILE_GRACE_HOURS=24

# OCR (installed locally in the worker image)
OCR_DEFAULT_LANGUAGES=eng+tur
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# Optional SMTP for signature-lite invitations. Leave disabled for manual-link mode.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Local structured logs only; never add remote telemetry endpoints.
LOG_LEVEL=INFO
LOG_FORMAT=json
TELEMETRY_ENABLED=false
